# CRM Ticket System — Environment Variables
#
# Architecture: Vercel (frontend) → Railway (FastAPI backend) → Supabase PostgreSQL
#
# ─── BACKEND (Railway) ────────────────────────────────────────────────────────
# Set these in Railway dashboard → your service → Variables

# Supabase PostgreSQL connection string
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Secret key for JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Vercel frontend URL for CORS (set after deploying frontend)
# Supports comma-separated multiple origins for preview URLs
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Demo user credentials (optional — defaults used if not set)
DEMO_USER_EMAIL=user@demo.com
DEMO_USER_PASSWORD=user123
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=admin123

# Google OAuth Client ID (optional — leave empty to disable)
GOOGLE_CLIENT_ID=

# ─── FRONTEND (Vercel) ────────────────────────────────────────────────────────
# Set these in Vercel dashboard → Settings → Environment Variables

# Your Railway backend URL (required — without trailing slash)
VITE_API_URL=https://your-backend.up.railway.app

# Google OAuth Client ID (optional — same value as backend)
VITE_GOOGLE_CLIENT_ID=
