# Backend environment variables
# Copy this file to backend/.env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Replace [PASSWORD] with your actual Supabase project password
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret key for JWT signing — CHANGE THIS in production!
SECRET_KEY=your-super-secret-key-here

# Token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google OAuth Client ID
# Get this for FREE at https://console.cloud.google.com/
# Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web)
# Add your app's origin (e.g. http://localhost:5173 and your production URL) as Authorized JS origins
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (set this after deploying frontend to Vercel)
FRONTEND_ORIGIN=https://your-frontend.vercel.app
