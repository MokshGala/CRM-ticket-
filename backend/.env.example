# Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
# On Railway: set these in the Railway dashboard → Variables tab.

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Replace [PASSWORD] with your actual Supabase project password
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret key for JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your deployed Vercel frontend URL (set after deploying frontend)
# Supports comma-separated multiple origins: https://app.vercel.app,https://preview.vercel.app
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# ─── Demo Credentials (optional — defaults used if not set) ───────────────────
# These users are seeded automatically on first startup.
# Change them to customise the demo experience.
DEMO_USER_NAME=Demo User
DEMO_USER_EMAIL=user@demo.com
DEMO_USER_PASSWORD=user123

DEMO_ADMIN_NAME=Admin User
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=admin123

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Leave empty to disable Google Sign-In
GOOGLE_CLIENT_ID=
