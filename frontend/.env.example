# Frontend environment variables
# Copy this file to .env and fill in your values

# Backend API URL — LOCAL DEV ONLY
# Required when running frontend (port 5173) and backend (port 8000) separately.
# In production (single Vercel project), leave VITE_API_URL unset — the frontend and
# backend share the same domain so /api/* calls are same-origin (no CORS needed).
VITE_API_URL=http://localhost:8000

# Google OAuth Client ID (same one you put in backend .env)
# Leave empty to disable the Google Sign-In button entirely
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
