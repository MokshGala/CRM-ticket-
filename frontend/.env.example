# Frontend Environment Variables
# Copy this file to frontend/.env and fill in your values.
# On Vercel: set these in the Vercel dashboard → Settings → Environment Variables.

# ─── Backend API URL ──────────────────────────────────────────────────────────
# REQUIRED in production: set this to your Railway backend URL.
# In Vercel dashboard: VITE_API_URL = https://your-backend.up.railway.app
#
# LOCAL DEV: point to your local FastAPI server
VITE_API_URL=http://localhost:8000

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Same Google Client ID as backend. Leave empty to disable the Google Sign-In button.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
